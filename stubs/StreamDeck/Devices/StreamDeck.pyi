import abc
from abc import ABC, abstractmethod
from enum import Enum

from _typeshed import Incomplete

from ..Transport.Transport import TransportError as TransportError

class TouchscreenEventType(Enum):
    SHORT = 1
    LONG = 2
    DRAG = 3

class DialEventType(Enum):
    TURN = 1
    PUSH = 2

class ControlType(Enum):
    KEY = 1
    DIAL = 2
    TOUCHSCREEN = 3

class StreamDeck(ABC, metaclass=abc.ABCMeta):
    KEY_COUNT: int
    KEY_COLS: int
    KEY_ROWS: int
    TOUCH_KEY_COUNT: int
    KEY_PIXEL_WIDTH: int
    KEY_PIXEL_HEIGHT: int
    KEY_IMAGE_FORMAT: str
    KEY_FLIP: Incomplete
    KEY_ROTATION: int
    TOUCHSCREEN_PIXEL_WIDTH: int
    TOUCHSCREEN_PIXEL_HEIGHT: int
    TOUCHSCREEN_IMAGE_FORMAT: str
    TOUCHSCREEN_FLIP: Incomplete
    TOUCHSCREEN_ROTATION: int
    SCREEN_PIXEL_WIDTH: int
    SCREEN_PIXEL_HEIGHT: int
    SCREEN_IMAGE_FORMAT: str
    SCREEN_FLIP: Incomplete
    SCREEN_ROTATION: int
    DIAL_COUNT: int
    DECK_TYPE: str
    DECK_VISUAL: bool
    DECK_TOUCH: bool
    device: Incomplete
    last_key_states: Incomplete
    last_dial_states: Incomplete
    read_thread: Incomplete
    run_read_thread: bool
    read_poll_hz: int
    key_callback: Incomplete
    dial_callback: Incomplete
    touchscreen_callback: Incomplete
    update_lock: Incomplete
    def __init__(self, device) -> None: ...
    def __del__(self) -> None: ...
    def __enter__(self) -> None: ...
    def __exit__(
        self, type: type[BaseException] | None, value: BaseException | None, traceback: types.TracebackType | None
    ) -> None: ...
    def open(self) -> None: ...
    def close(self) -> None: ...
    def is_open(self): ...
    def connected(self): ...
    def vendor_id(self): ...
    def product_id(self): ...
    def id(self): ...
    def key_count(self): ...
    def touch_key_count(self): ...
    def dial_count(self): ...
    def deck_type(self): ...
    def is_visual(self): ...
    def is_touch(self): ...
    def key_layout(self): ...
    def key_image_format(self): ...
    def touchscreen_image_format(self): ...
    def screen_image_format(self): ...
    def set_poll_frequency(self, hz) -> None: ...
    def set_key_callback(self, callback) -> None: ...
    def set_key_callback_async(self, async_callback, loop: Incomplete | None = None) -> None: ...
    def set_dial_callback(self, callback) -> None: ...
    def set_dial_callback_async(self, async_callback, loop: Incomplete | None = None) -> None: ...
    def set_touchscreen_callback(self, callback) -> None: ...
    def set_touchscreen_callback_async(self, async_callback, loop: Incomplete | None = None) -> None: ...
    def key_states(self): ...
    def dial_states(self): ...
    @abstractmethod
    def reset(self): ...
    @abstractmethod
    def set_brightness(self, percent): ...
    @abstractmethod
    def get_serial_number(self): ...
    @abstractmethod
    def get_firmware_version(self): ...
    @abstractmethod
    def set_key_image(self, key, image): ...
    @abstractmethod
    def set_touchscreen_image(self, image, x_pos: int = 0, y_pos: int = 0, width: int = 0, height: int = 0): ...
    @abstractmethod
    def set_key_color(self, key, r, g, b): ...
    @abstractmethod
    def set_screen_image(self, image): ...
