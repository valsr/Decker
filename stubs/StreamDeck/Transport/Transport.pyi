import abc
from abc import ABC, abstractmethod

class TransportError(Exception): ...

class Transport(ABC, metaclass=abc.ABCMeta):
    class Device(ABC, metaclass=abc.ABCMeta):
        @abstractmethod
        def open(self): ...
        @abstractmethod
        def close(self): ...
        @abstractmethod
        def is_open(self): ...
        @abstractmethod
        def connected(self): ...
        @abstractmethod
        def path(self): ...
        @abstractmethod
        def vendor_id(self): ...
        @abstractmethod
        def product_id(self): ...
        @abstractmethod
        def write_feature(self, payload): ...
        @abstractmethod
        def read_feature(self, report_id, length): ...
        @abstractmethod
        def write(self, payload): ...
        @abstractmethod
        def read(self, length): ...

    @staticmethod
    @abstractmethod
    def probe(): ...
    @abstractmethod
    def enumerate(self, vid, pid): ...
