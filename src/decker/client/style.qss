/* ── Decker application stylesheet ── */

/* Base window */
QMainWindow {
    background-color: #3e3e3e;
    color: #e3e3e3;
}

/* ── Key buttons ── */
KeyButtonWidget {
    background-color: #2c2c2e;
    border: 0.15em solid #1c1c1e;
    border-radius: 2em;
    color: #f5f5f7;
    font-size: 11px;
    font-weight: 500;
}

KeyButtonWidget:hover {
    background-color: #3a3a3c;
    border: 0.15em solid #0096ef;
}

KeyButtonWidget:pressed {
    background-color: #1c1c1e;
}

/* ── Toast notification ── */
QLabel#toast {
    background-color: #e8e8ed;
    border-radius: 4px;
    color: #c0392b;
    padding: 6px 10px;
}

/* ── Connecting overlay ── */
QLabel#connecting-label {
    color: #f5f5f7;
    font-size: 15px;
    font-weight: 500;
    background: transparent;
}

QPushButton#connecting-settings-btn {
    background-color: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 6px;
    color: #f5f5f7;
    font-size: 13px;
    padding: 6px 16px;
}

QPushButton#connecting-settings-btn:hover {
    background-color: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.4);
}

QPushButton#connecting-settings-btn:pressed {
    background-color: rgba(255, 255, 255, 0.08);
}

/* ── Semantic label roles ── */
QLabel[role="title"] {
    color: #48484a;
    font-size: 13px;
    font-weight: bold;
}

QLabel[role="subtitle"] {
    color: #6e6e73;
    font-size: 11px;
}

QLabel[role="body"] {
    color: #1c1c1e;
    font-size: 14px;
}

QLabel[role="muted"] {
    color: #8e8e93;
    font-size: 12px;
}

QLabel[role="success"] {
    color: #2d8a4e;
    font-size: 12px;
}

QLabel[role="error"] {
    color: #c0392b;
    font-size: 12px;
}
