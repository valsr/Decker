{
  "format": 1,
  "id": "com.decker.counter",
  "name": "Counter",
  "version": "1.0.0",
  "author": "Decker",
  "description": "Counts key presses.",
  "homepage": "https://github.com/valsr/Decker",
  "icon": "icons/counter",
  "category": "Utilities",
  "runtime": { "type": "python", "entry": "plugin.py" },
  "contributes": {
    "actions": [
      {
        "id": "com.decker.counter.counter",
        "name": "Counter",
        "tooltip": "Press to count, long press to reset",
        "icon": "icons/counter",
        "gestures": ["press", "long_press"],
        "settings": [
          { "section": "Counting" },
          { "key": "step", "type": "int", "label": "Step", "default": 1, "min": 1, "max": 9999 },
          { "key": "double_step", "type": "int", "label": "Double press step", "optional": true,
            "placeholder": "None (presses register immediately)", "min": -9999, "max": 9999 },
          { "key": "max", "type": "int", "label": "Max count", "default": 0, "min": 0, "max": 99999,
            "special_value": "∞ (no limit)" },
          { "section": "Appearance" },
          { "key": "background", "type": "color", "label": "Background", "default": "#1f618d" },
          { "key": "title", "type": "text", "label": "Title", "default": "" },
          { "key": "title_position", "type": "choice", "label": "Title position", "default": "bottom",
            "options": [
              { "label": "Top", "value": "top" },
              { "label": "Middle", "value": "middle" },
              { "label": "Bottom", "value": "bottom" }
            ] },
          { "key": "title_font", "type": "font", "label": "Title font", "default": "DejaVu Sans" },
          { "key": "title_size", "type": "int", "label": "Title size", "default": 12, "min": 4, "max": 48 },
          { "key": "title_color", "type": "color", "label": "Title color", "default": "#ffffff" },
          { "key": "title_outline", "type": "color", "label": "Title outline", "optional": true },
          { "key": "title_outline_width", "type": "int", "label": "Outline width", "default": 1, "min": 1, "max": 6 }
        ]
      }
    ]
  }
}
